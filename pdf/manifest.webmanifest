{
  "name": "C.A.R.T.A. · Lettore PDF e P7M",
  "short_name": "C.A.R.T.A.",
  "description": "Apri, verifica e stampa PDF e documenti firmati digitalmente (.p7m, .tsd, .m7m). Tutto avviene sul tuo dispositivo.",
  "lang": "it",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f7f8fa",
  "theme_color": "#f7f8fa",
  "icons": [
    { "src": "icons/icon-192.png?v=rossa", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png?v=rossa", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png?v=rossa", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg?v=rossa", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [".pdf"],
        "application/pkcs7-mime": [".p7m"],
        "application/timestamped-data": [".tsd"],
        "application/x-m7m": [".m7m"]
      }
    }
  ],
  "share_target": {
    "action": "./?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": ["application/pdf", "application/pkcs7-mime", "application/x-pkcs7-mime", "application/octet-stream", ".pdf", ".p7m", ".tsd", ".m7m"]
        }
      ]
    }
  }
}
